// This is the Prisma schema for Neon PostgreSQL.
// After setting DATABASE_URL in .env, run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  VENDEDOR
  BODEGA
}

model Product {
  id          String      @id @default(cuid())
  sku         String      @unique
  name        String
  category    String
  description String?
  price       Decimal
  cost        Decimal
  stock       Int         @default(0)
  minimum     Int         @default(0)
  status      ProductStatus @default(ACTIVO)
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  saleItems   SaleItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum ProductStatus {
  ACTIVO
  INACTIVO
  BAJO_STOCK
  CRITICO
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  contact   String
  phone     String
  category  String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?  @unique
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id            String      @id @default(cuid())
  total         Decimal
  status        SaleStatus  @default(COMPLETADO)
  paymentMethod String?
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum SaleStatus {
  COMPLETADO
  PENDIENTE
  CANCELADO
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal
  sale      Sale     @relation(fields: [saleId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}
