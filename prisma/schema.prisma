// This is the Prisma schema for Neon PostgreSQL.
// After setting DATABASE_URL in .env, run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDEDOR
  BODEGA
}

enum ProductStatus {
  ACTIVO
  INACTIVO
  BAJO_STOCK
  CRITICO
}

enum SaleStatus {
  COMPLETADO
  PENDIENTE
  CANCELADO
}

enum BranchStatus {
  ACTIVA
  INACTIVA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Branch {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  address     String
  city        String
  phone       String?
  email       String?
  status      BranchStatus @default(ACTIVA)
  users       User[]
  products    BranchProduct[]
  sales       Sale[]
  movements   InventoryMovement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  contact   String
  phone     String
  category  String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String         @id @default(cuid())
  sku         String         @unique
  barcode     String?
  name        String
  activeIngredient String?
  category    String
  manufacturer String?
  presentation String?
  description String?
  price       Decimal
  cost        Decimal
  stock       Int            @default(0)
  minimum     Int            @default(0)
  status      ProductStatus  @default(ACTIVO)
  supplierId  String?
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  branchProducts BranchProduct[]
  batches     Batch[]
  saleItems   SaleItem[]
  inventories InventoryMovement[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model BranchProduct {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  stock     Int      @default(0)
  minStock  Int      @default(0)
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
}

model Batch {
  id            String   @id @default(cuid())
  productId     String
  branchId      String
  lotNumber     String
  expirationDate DateTime?
  quantity      Int      @default(0)
  product       Product  @relation(fields: [productId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, branchId, lotNumber])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?  @unique
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id             String      @id @default(cuid())
  operationNumber String     @unique @default(cuid())
  branchId       String
  userId         String?
  customerId     String?
  status         SaleStatus  @default(COMPLETADO)
  total          Decimal
  paymentMethod  String?
  branch         Branch      @relation(fields: [branchId], references: [id])
  customer       Customer?   @relation(fields: [customerId], references: [id])
  items          SaleItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  sale      Sale     @relation(fields: [saleId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model InventoryMovement {
  id          String   @id @default(cuid())
  branchId    String
  productId   String
  quantity    Int
  movementType String
  reason      String?
  createdBy  String?
  branch      Branch   @relation(fields: [branchId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
}
